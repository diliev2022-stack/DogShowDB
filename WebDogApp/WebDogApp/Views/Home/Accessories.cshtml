@{
    ViewData["Title"] = "Accessories";
}

<div class="container mt-5 mb-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">Аксесоари за кучета</h1>
        <p class="lead text-muted">
            Открийте всичко необходимо за комфорта и щастието на вашия любимец!
        </p>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">

        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://images.unsplash.com/photo-1548199973-03cce0bbc87b?w=500"
                     class="card-img-top" alt="Нагръдник"
                     style="height:250px; object-fit:cover;">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Ергономичен нагръдник</h5>
                    <p class="card-text fw-bold text-primary fs-5">Цена: 45.00 €</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://images.unsplash.com/photo-1551717743-49959800b1f6?w=500"
                     class="card-img-top" alt="Играчка"
                     style="height:250px; object-fit:cover;">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Играчка за кучета</h5>
                    <p class="card-text fw-bold text-primary fs-5">Цена: 12.00 €</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://images.unsplash.com/photo-1589924691995-400dc9ecc119?w=500"
                     class="card-img-top" alt="Кучешка храна"
                     style="height:250px; object-fit:cover;">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Купа за храна</h5>
                    <p class="card-text fw-bold text-primary fs-5">Цена: 18.00 €</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://media.self.com/photos/630e7a47ee9e37c5e2645c60/16%3A9/w_5247%2Ch_2951%2Cc_limit/best-dog-beds.jpg"
                     class="card-img-top" alt="Куче в удобно легло"
                     style="height:250px; object-fit:cover;">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Удобно легло</h5>
                    <p class="card-text fw-bold text-primary fs-5">Цена: 65.00 €</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://images.unsplash.com/photo-1552053831-71594a27632d?w=500"
                     class="card-img-top" alt="Куче"
                     style="height:250px; object-fit:cover;">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Комплект за разходка</h5>
                    <p class="card-text fw-bold text-primary fs-5">Цена: 30.00 €</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://images.unsplash.com/photo-1583337130417-3346a1be7dee?w=500"
                     class="card-img-top" alt="Куче с аксесоар"
                     style="height:250px; object-fit:cover;">
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">Зимно яке за куче</h5>
                    <p class="card-text fw-bold text-primary fs-5">Цена: 40.00 €</p>
                </div>
            </div>
        </div>

    </div>
</div>
