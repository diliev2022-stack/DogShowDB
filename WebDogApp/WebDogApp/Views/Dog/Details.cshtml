@model WebDogApp.Models.Dog.DetailsVM

@{
    ViewData["Title"] = "Dog Details";
}

<h1>Dog Details</h1>

<div>
    <h4>@Model.Name</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Age</dt>
        <dd class="col-sm-10">@Model.Age</dd>

        <dt class="col-sm-2">Breed</dt>
        <dd class="col-sm-10">@Model.BreedName</dd>

        <dt class="col-sm-2">Picture</dt>
        <dd class="col-sm-10">
            <img src="@Model.Picture" width="200" />
        </dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
